# Address on which the host publishes the TCP input and web UI.
# Keep 127.0.0.1 when using a reverse proxy, or set a trusted LAN address.
BIND_ADDRESS=127.0.0.1

# Change before starting the service.
LOGDY_UI_PASS=replace-with-a-long-password

# Host path where received messages are kept.
DATA_DIR=./data

SYSLOG_PORT=1514
WEB_PORT=8086
LOGDY_IMAGE=ghcr.io/ptiyannou/logdy-docker:latest
LOGDY_LOG_FILE=/data/logdy.log
LOGDY_ROTATE_FILE_SIZE=25M
LOGDY_MAX_MESSAGES=10000
